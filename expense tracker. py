expenses = [
    ["Food", 100],
    ["Travel", 50],
    ["Books", 200]
]

expense_name = input("Enter expense name: ")
amount = int(input("Enter amount: "))

expenses.append([expense_name, amount])

print("\nExpenses:")

for expense in expenses:
    print(expense)

total = 0

for expense in expenses:
    total += expense[1]

print("\nTotal Expense:", total)